
import { useRef, useState } from "react";
import * as XLSX from "xlsx";
import "./App.css";

type AlertInfo = {
  id: string;
  sheet: string;
  cell: string;
  title: string;
  detail: string;
  severity: "critical" | "warning";
};

type SheetInfo = {
  name: string;
  rows: string[][];
  rowCount: number;
  columnCount: number;
  formulaCount: number;
  errors: { cell: string; value: string }[];
  alerts: AlertInfo[];
};

type MatchRecord = {
  sheet: string;
  row: number;
  id: string;
  name: string;
};

type MatchInfo = {
  id: string;
  type: string;
  confidence: string;
  records: MatchRecord[];
};

type ImportInfo = {
  name: string;
  date: string;
  size: string;
  sheets: number;
  rows: number;
};

type Dimension = {
  key: string;
  label: string;
  aliases: string[];
};

const DIMENSIONS: Dimension[] = [
  {
    key: "country",
    label: "Countries",
    aliases: ["country", "projectcountry", "locationcountry"],
  },
  {
    key: "nationality",
    label: "Nationalities",
